[Unit]
Description=Deck Fly Brain — autonomous flight decision service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=MAVLINK_DEVICE=/dev/ttyACM0
Environment=MAVLINK_BAUD=57600
Environment=MAVLINK_SOURCE_SYSTEM=255
Environment=MAVLINK_SOURCE_COMPONENT=190
Environment=MAVLINK_TARGET_SYSTEM=1
Environment=MAVLINK_TARGET_COMPONENT=1
WorkingDirectory=/home/deck/.local/share/dfb
ExecStart=/home/deck/.local/share/dfb/.venv/bin/uvicorn dfb.service:app --host 0.0.0.0 --port 8082
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flybrain

# Resource limits for Steam Deck (8GB RAM, 4C/8T)
MemoryMax=2G
CPUQuota=200%
MemoryHigh=1.5G

# Prevent Deck sleep while service runs
ExecStartPre=/usr/bin/systemd-inhibit --what=handle-lid-switch:sleep --who="Fly Brain" --mode=block --why="Flight service must stay awake"

[Install]
WantedBy=default.target