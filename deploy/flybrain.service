[Unit]
Description=Deck Fly Brain — autonomous flight decision service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=TELEMETRY_PROTOCOL=auto
Environment=MAVLINK_DEVICE=/dev/ttyACM0
Environment=MAVLINK_BAUD=57600
Environment=MAVLINK_SOURCE_SYSTEM=255
Environment=MAVLINK_SOURCE_COMPONENT=190
Environment=MAVLINK_TARGET_SYSTEM=1
Environment=MAVLINK_TARGET_COMPONENT=1
Environment=CRSF_DEVICE=/dev/ttyACM1
Environment=CRSF_BAUD=420000
WorkingDirectory=/home/deck/.local/share/dfb

# Run uvicorn under the sleep inhibitor: the lock is held for the lifetime
# of the service process, not a one-shot pre-start hook. Blocks Deck sleep
# and lid-close while the flight service is up.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:handle-lid-switch --who="Fly Brain" --mode=block --why="Flight service must stay awake" -- /home/deck/.local/share/dfb/.venv/bin/uvicorn dfb.service:app --host 0.0.0.0 --port 8082
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flybrain

# Resource limits for Steam Deck (8GB RAM, 4C/8T)
MemoryMax=2G
CPUQuota=200%
MemoryHigh=1.5G

[Install]
WantedBy=default.target